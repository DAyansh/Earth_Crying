# ============================================
# Earth Crying Backend — Environment Variables
# Copy this file to `.env` and fill in values.
# ============================================

# --- Server ---
PORT=8080

# --- PostgreSQL ---
DATABASE_URL=jdbc:postgresql://localhost:5432/earth_crying
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Redis (cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT Auth ---
# Use a long random string (at least 32 chars) in production!
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Mail (newsletter / streak reminders) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- External Data APIs (Hope Ledger aggregator) ---
# See https://data-api.globalforestwatch.org
GFW_API_KEY=
# See https://www.ncei.noaa.gov
NOAA_API_KEY=
# See https://docs.openaq.org
OPENAQ_API_KEY=
# See https://api.nasa.gov  (DEMO_KEY works for low-rate local dev)
NASA_API_KEY=DEMO_KEY
